model Currency {
  curr_id    String   @id @default(uuid()) @db.Uuid
  curr_name  String   @db.VarChar(100)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  status     String   @db.VarChar(50)

  properties Property[]
  bookings   Booking[]

  @@map("currencies")
}

model Booking {
  booking_id       String    @id @default(uuid()) @db.Uuid
  user_id          String    @db.Uuid
  property_id      String    @db.Uuid
  check_in_date    DateTime
  check_out_date   DateTime
  price_per_day    Decimal   @db.Decimal(10, 2)
  price_for_stay   Decimal   @db.Decimal(10, 2)
  tax_paid         Decimal   @db.Decimal(10, 2)
  amount_paid      Decimal   @db.Decimal(10, 2)
  is_refund        Boolean   @default(false)
  cancel_date      DateTime?
  refund_paid      Decimal?  @db.Decimal(10, 2)
  transaction_id   String?   @db.Uuid
  effective_amount Decimal?  @db.Decimal(10, 2)
  booking_date     DateTime
  currency_id      String    @db.Uuid
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  status           String    @db.VarChar(50)

  user             User             @relation(fields: [user_id], references: [user_id])
  property         Property         @relation(fields: [property_id], references: [property_id])
  currency         Currency         @relation(fields: [currency_id], references: [curr_id])
  transaction      Transaction?     @relation(fields: [transaction_id], references: [trans_id])
  reviews          PropertyReview[]
  disputes         Dispute[]

  @@map("bookings")
}