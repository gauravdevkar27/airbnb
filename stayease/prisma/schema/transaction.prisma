model Transaction {
  trans_id          String    @id @default(uuid()) @db.Uuid
  prop_id           String    @db.Uuid
  payee_id          String    @db.Uuid
  booking_id        String?   @db.Uuid
  tax_fees          String?   @db.VarChar(100)
  amount            Decimal   @db.Decimal(10, 2)
  transfer_on_date  DateTime?
  currency_id       String    @db.Uuid
  promo_code_id     String?   @db.Uuid   // ← linked but not enforced (free tier)
  discount_amount   Decimal?  @db.Decimal(10, 2)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  status            String    @db.VarChar(50)
  
  promo_code  PromoCode? @relation(fields: [promo_code_id], references: [promo_code_id])


  bookings          Booking[]

  @@map("transactions")
}