model PropertyType {
  prop_type_id   String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(100)
  prop_icon_img  String?  @db.VarChar(500)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  status         String   @db.VarChar(50)

  properties     Property[]

  @@map("property_types")
}

model RoomType {
  room_id        String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(100)
  room_icon_img  String?  @db.VarChar(500)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  status         String   @db.VarChar(50)

  properties     Property[]

  @@map("room_types")
}

model Category {
  category_id  String        @id @default(uuid()) @db.Uuid
  name         String        @db.VarChar(100)
  discription  String?       @db.VarChar(255)
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt
  status       String        @db.VarChar(50)

  sub_categories SubCategory[]
  properties     Property[]

  @@map("categories")
}

model SubCategory {
  sub_category_id String   @id @default(uuid()) @db.Uuid
  category_id     String   @db.Uuid
  name            String   @db.VarChar(100)
  description     String?  @db.VarChar(255)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  status          String   @db.VarChar(50)

  category        Category @relation(fields: [category_id], references: [category_id])

  @@map("sub_categories")
}

model Property {
  property_id       String   @id @default(uuid()) @db.Uuid
  name              String   @db.VarChar(255)
  description       String?  @db.VarChar(255)
  property_type_id  String   @db.Uuid
  room_type_id      String   @db.Uuid
  category_id       String   @db.Uuid
  subcategory_type  String?  @db.VarChar(100)
  category_type_id  String?  @db.Uuid
  state_id          String?  @db.Uuid
  city_id           String   @db.Uuid
  address           String?  @db.VarChar(500)
  status            String   @db.VarChar(50)
  altitude          String?  @db.VarChar(100)
  longitude         String?  @db.VarChar(100)
  bedroom_count     Int
  bed_count         Int
  bathroom_count    Int
  availability_type Boolean  @default(true)
  start_date        DateTime
  end_date          DateTime
  currency_id       String   @db.Uuid
  price             Decimal  @db.Decimal(10, 2)
  price_type        String?  @db.VarChar(50)
  min_day           Int
  min_stay_type     String?  @db.VarChar(50)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  user_id           String   @db.Uuid

  user              User             @relation(fields: [user_id], references: [user_id])
  property_type     PropertyType     @relation(fields: [property_type_id], references: [prop_type_id])
  room_type         RoomType         @relation(fields: [room_type_id], references: [room_id])
  category          Category         @relation(fields: [category_id], references: [category_id])
  city              City             @relation(fields: [city_id], references: [city_id])
  currency          Currency         @relation(fields: [currency_id], references: [curr_id])
  images            PropertyImage[]
  amenities         PropertyAmenity[]
  reviews           PropertyReview[]
  bookings          Booking[]
  disputes          Dispute[]

  @@map("properties")
}

model PropertyImage {
  prop_img_id  String   @id @default(uuid()) @db.Uuid
  property_id  String   @db.Uuid
  user_id      String   @db.Uuid
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  status       String   @db.VarChar(50)

  property     Property @relation(fields: [property_id], references: [property_id])
  user         User     @relation(fields: [user_id], references: [user_id])

  @@map("property_images")
}