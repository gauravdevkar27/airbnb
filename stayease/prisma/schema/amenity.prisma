model Amenity {
  amenity_id      String   @id @default(uuid()) @db.Uuid
  prop_amenity_id String   @db.Uuid
  prop_icon_img   String?  @db.VarChar(500)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  status          String   @db.VarChar(50)

  property_amenities PropertyAmenity[]

  @@map("amenities")
}

model PropertyAmenity {
  prop_amenity_id String   @id @default(uuid()) @db.Uuid
  prop_id         String   @db.Uuid
  amenity_id      String   @db.Uuid
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  status          String   @db.VarChar(50)

  property        Property @relation(fields: [prop_id], references: [property_id])
  amenity         Amenity  @relation(fields: [amenity_id], references: [amenity_id])

  @@map("property_amenities")
}